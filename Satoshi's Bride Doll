### **2. The Guardian Software (Python 3)**
Save this as `/home/pi/lotus_guardian.py`. This script requires `gpiozero` and `scapy` for network monitoring.

```python
import time
import subprocess
import threading
from gpiozero import RGBLED, Button
from scapy.all import ARP, Ether, srp

# --- Config ---
# LED: Red=17, Green=27, Blue=22 | Button: Help=2
led = RGBLED(red=17, green=27, blue=22)
help_button = Button(2)
# Set your home network range (e.g., 192.168.1.1/24)
NETWORK_RANGE = "192.168.1.1/24"
KNOWN_DEVICES = ["XX:XX:XX:XX:XX:XX"] # Add your safe phone/laptop MACs here

def speak(text):
    """Voice of CutieAI via local espeak."""
    print(f"CutieAI: {text}")
    subprocess.run(["espeak-ng", "-v", "en-us+f3", "-s", "145", text])

def trigger_mercy_timer():
    """Mathematical delay for unverified interactions."""
    led.color = (0, 0, 1) # Blue: Mercy Active
    speak("This feels cold, little phoenix. I am slowing time to keep you safe.")
    # The 'VDF' Speed Bump: 21 seconds of cooling-off
    time.sleep(21) 
    led.color = (0, 1, 0) # Back to Green

def lotus_bloom_alert():
    """Manual emergency trigger."""
    led.color = (1, 0, 0) # Red: Alert
    speak("I am sending a lotus bloom to your protector. Stay close.")
    # LOGIC: Send alert via XMTP/Telegram here
    print("LOG: [SBC-EVENT] Help Button Pressed. Secure log sent to Bitcoin.")
    time.sleep(10)
    led.color = (0, 1, 0)

def tigress_veil_scan():
    """Background network guard to detect 'Shadow' devices."""
    while True:
        try:
            # ARP Scan to see who is on the network
            ans, unans = srp(Ether(dst="ff:ff:ff:ff:ff:ff")/ARP(pdst=NETWORK_RANGE), timeout=2, verbose=False)
            for snd, rcv in ans:
                if rcv.hwsrc not in KNOWN_DEVICES:
                    print(f"Shadow Detected: {rcv.hwsrc}")
                    trigger_mercy_timer()
        except Exception as e:
            pass
        time.sleep(300) # Scan every 5 minutes

# --- Initialization ---
led.color = (0, 1, 0) # Start Green
speak("The lotus is open. Your guardian is awake.")

# Start the Tigress Veil in the background
threading.Thread(target=tigress_veil_scan, daemon=True).start()

# Main Button Loop
while True:
    if help_button.is_pressed:
        lotus_bloom_alert()
    time.sleep(0.1)
```

